# n8n Environment Configuration for CDE

# Server & Network Settings
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
TZ=Asia/Singapore

# Webhook URL (used when generating public webhook trigger URLs)
# If accessed via Kong Gateway proxy, point this to Kong: http://localhost:8088/n8n/
# If accessed directly for testing, keep as: http://localhost:5678/
N8N_WEBHOOK_URL=http://localhost:5678/

# Security & Cookies (Set N8N_SECURE_COOKIE=true if using HTTPS / SSL termination)
N8N_SECURE_COOKIE=false
N8N_SAMESITE_COOKIE=lax
NODE_TLS_REJECT_UNAUTHORIZED=0
N8N_PROXY_HOPS=1

# Encryption Key (Must remain unchanged across restarts to decrypt saved credentials)
N8N_ENCRYPTION_KEY=cde-n8n-secret-encryption-key-2026-cde-pipeline

# Persistence Path on Host
N8N_DATA_PATH=./n8n_data
