# n8n Environment Configuration for CDE (Enterprise setup mirroring taylor-imops-lite)

# Server & Network Settings
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=https
TZ=Asia/Singapore

# Webhook URL (used when generating public webhook trigger URLs)
# Pointed to HTTPS endpoint for SSL proxy
N8N_WEBHOOK_URL=https://localhost:5678/

# Security & Cookies (configured for HTTPS / SSL reverse proxy and iframe embedding)
N8N_SECURE_COOKIE=true
N8N_SAMESITE_COOKIE=none
NODE_TLS_REJECT_UNAUTHORIZED=0
N8N_PROXY_HOPS=1

# Encryption Key (Must remain unchanged across restarts to decrypt saved credentials)
N8N_ENCRYPTION_KEY=cde-n8n-secret-encryption-key-2026-cde-pipeline

# Persistence Path on Host
N8N_DATA_PATH=./n8n_data

# iMOPS Backend API (Option C Incident Ingestion)
BACKEND_API=http://host.docker.internal:13000
