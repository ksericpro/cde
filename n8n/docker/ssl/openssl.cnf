[req]
default_bits = 4096
prompt = no
default_md = sha256
req_extensions = req_ext
distinguished_name = dn

[dn]
C = MY
ST = Federal Territory
L = Kuala Lumpur
O = ZAARR IDT
OU = iMOPS Lite
CN = iMOPS Lite Security Platform
emailAddress = admin@imops.local

[req_ext]
subjectAltName = @alt_names
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[alt_names]
IP.1 = 10.99.32.54
IP.2 = 127.0.0.1
IP.3 = 0.0.0.0
DNS.1 = localhost
DNS.2 = imops.local
DNS.3 = *.imops.local
DNS.4 = imops-lite
DNS.5 = *.imops-lite
