[req]
default_bits = 4096
prompt = no
default_md = sha256
req_extensions = req_ext
distinguished_name = dn

[dn]
C = MY
ST = Federal Territory
L = Kuala Lumpur
O = Taylor University
OU = IT Department
CN = iMOPS Lite - Taylor University KL
emailAddress = it@taylors.edu.my

[req_ext]
subjectAltName = @alt_names
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[alt_names]
IP.1 = 127.0.0.1
IP.2 = 0.0.0.0
DNS.1 = localhost
DNS.2 = imops.tayloruniversity.local
DNS.3 = *.tayloruniversity.local
DNS.4 = imops-lite.local
DNS.5 = *.imops-lite.local
