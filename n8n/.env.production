# n8n Production Environment Configuration for Taylor's University
# Server & Network Settings
N8N_HOST=10.99.32.55
N8N_PORT=5678
N8N_PROTOCOL=https
TZ=Asia/Singapore

# Webhook URL (used when generating public webhook URLs in the UI)
N8N_WEBHOOK_URL=https://10.99.32.55:5678/

# Security & Cookies (for HTTPS reverse proxy and iframe embedding)
N8N_SECURE_COOKIE=true
N8N_SAMESITE_COOKIE=none
NODE_TLS_REJECT_UNAUTHORIZED=0
N8N_PROXY_HOPS=1

# Encryption Key (matches your persistent config)
N8N_ENCRYPTION_KEY=cde-n8n-secret-encryption-key-2026-cde-pipeline

# Persistence Path on Host
N8N_DATA_PATH=./n8n_data

# Proscalar -> iMOPS Backend API (Option C Incident Ingestion)
