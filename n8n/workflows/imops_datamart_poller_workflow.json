      "name": "4A. Bronze: Archive Raw Payloads (s3://lake-raw)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1060, 320]
    },
    {
      "parameters": {
        "jsCode": "// ============================================================================\n// SILVER TRANSFORMATION RULES (Visible in n8n Canvas)\n// Normalizes iMOPS Raw Payloads -> Conformed Star Schema Dimensions & Facts\n// ============================================================================\nconst bronzeOutput = $input.first().json || {};\n\nconst slaTargetsBySeverity = {\n  critical: { slaMinutes: 5, slaSeconds: 300 },\n  high:     { slaMinutes: 10, slaSeconds: 600 },\n  medium:   { slaMinutes: 15, slaSeconds: 900 },\n  low:      { slaMinutes: 30, slaSeconds: 1800 }\n};\n\nconst starSchemaMappings = {\n  dimensions: [\n    'silver.dim_location (loc_<md5(site|building|floor|zone)>)',\n    'silver.dim_device (dev_<md5(site|device_name)>)',\n    'silver.dim_incident_type (itype_<md5(incident_type_code)>)'\n  ],\n  facts: [\n    'silver.fact_incidents_current (ON CONFLICT incident_number DO UPDATE)',\n    'silver.fact_incident_state_history (tracks status transitions)'\n  ],\n  kpiFormulas: {\n    mtta_seconds: 'EXTRACT(EPOCH FROM (acknowledged_at - detected_at))',\n    mttr_seconds: 'EXTRACT(EPOCH FROM (resolved_at - detected_at))',\n    is_sla_breached: 'mtta_seconds > (sla_target_minutes * 60) OR (status = active AND age > sla)'\n  }\n};\n\nreturn [{\n  json: {\n    stage: '4B. Silver Transformation Rule Engine',\n    bronzeStatus: bronzeOutput.status,\n    rawBatchesProcessed: bronzeOutput.rawBatchesSaved,\n    s3RawFiles: bronzeOutput.s3RawObjects,\n    slaTargetsBySeverity,\n    starSchemaMappings\n  }\n}];"
      },
      "id": "node-silver-rules",
      "name": "4B. Silver Rules: Normalize SLA & Star Schema Keys",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 320]
    },
