      "id": "node-switch-envelope",
      "name": "Switch Envelope Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst data = body.data || {};\nconst eventCode = String(data.eventCode || '');\n\nconst mappingTable = {\n  '5001': { incidentType: 'door_held_open', severity: 'medium', isIdle: false, eventName: 'Door Held Open' },\n  '5002': { incidentType: 'door_forced_open', severity: 'high', isIdle: false, eventName: 'Door Forced Open' },\n  '4001': { incidentType: 'reader_tamper', severity: 'high', isIdle: false, eventName: 'Reader Tamper' },\n  '4000': { incidentType: 'reader_tamper', severity: 'low', isIdle: true, pairCode: '4001', eventName: 'Reader Tamper Idle' },\n  '1003': { incidentType: 'panel_tamper', severity: 'critical', isIdle: false, eventName: 'Panel Tamper' },\n  '1002': { incidentType: 'panel_tamper', severity: 'low', isIdle: true, pairCode: '1003', eventName: 'Panel Tamper Idle' },\n  '1000': { incidentType: 'power_failure', severity: 'high', isIdle: false, eventName: 'Power Failure' },\n  '5014': { incidentType: 'emergency_exit', severity: 'critical', isIdle: false, eventName: 'Emergency Exit Opened' },\n  '5015': { incidentType: 'emergency_exit', severity: 'low', isIdle: true, pairCode: '5014', eventName: 'Emergency Exit Restored' }\n};\n\nconst mapping = mappingTable[eventCode] || {\n  incidentType: 'invalid_credential',\n  severity: 'medium',\n  isIdle: false,\n  eventName: 'Proscalar Security Alert'\n};\n\nconst deviceName = data.eventPointName || data.eventSourceName || 'Proscalar Device';\nconst title = `${mapping.eventName} - ${deviceName}`;\n\nreturn [{\n  json: {\n    type: body.type,\n    eventCode,\n    isIdleCode: mapping.isIdle,\n    activePairCode: mapping.pairCode || null,\n    incidentType: mapping.incidentType,\n    severity: mapping.severity,\n    deviceName,\n    title,\n    eventSourceId: data.eventSourceId,\n    eventPointId: data.eventPointId,\n    eventTimestamp: data.eventTimestamp || body.timestamp || new Date().toISOString(),\n    message: data.message || mapping.eventName,\n    rawData: data\n  }\n}];"
      },
