      "id": "node-http-resolve-point",
      "name": "Resolve Point Incident",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1180, 120]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst data = body.data || {};\nconst groupCode = String(data.groupEventCode || '');\nconst accessZones = data.accessZones || [];\n\nconst isResolution = ['12001', '12009', '12015'].includes(groupCode);\n\nconst isFire = accessZones.some(z => String(z.type).toUpperCase() === 'FIRE');\nconst isPanic = accessZones.some(z => String(z.type).toUpperCase() === 'PANIC');\nconst isMedical = accessZones.some(z => String(z.type).toUpperCase() === 'MEDICAL');\n\nlet incidentType = 'group_alarm';\nlet severity = 'medium';\n\nif (isFire) {\n  incidentType = 'fire_alarm';\n  severity = 'critical';\n} else if (isPanic) {\n  incidentType = 'panic_alarm';\n  severity = 'critical';\n} else if (isMedical) {\n  incidentType = 'medical_alarm';\n  severity = 'high';\n} else if (groupCode === '12008') {\n  incidentType = 'group_alarm_triggered';\n  severity = 'high';\n}\n\nconst deviceName = data.eventSourceName || data.name || 'Alarm Monitoring Group';\nconst title = `${data.name || 'ALARM GROUP'} - ${incidentType.toUpperCase()}`;\n\nreturn [{\n  json: {\n    type: body.type,\n    alarmGroupId: data.alarmGroupId,\n    groupEventCode: groupCode,\n    isResolution,\n    isTrigger: groupCode === '12008' || !isResolution,\n    isSafetyCategory: (isFire || isPanic || isMedical),\n    incidentType,\n    severity,\n    title,\n    deviceName,\n    eventTimestamp: data.eventTimestamp || body.timestamp || new Date().toISOString(),\n    rawData: data\n  }\n}];"
      },
