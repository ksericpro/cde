        {
          "name": "Get Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Check if the request was successful (Status 200)\r",
                  "if (pm.response.code === 200) {\r",
                  "    \r",
                  "    const response = pm.response.json();\r",
                  "\r",
                  "    // 2. Check if the API's internal success flag is true\r",
                  "    if (response.success === true) {\r",
                  "        \r",
                  "        // 3. Extract and save the tokens\r",
                  "        const accessToken = response.data.token;\r",
                  "        const refreshToken = response.data.refreshToken;\r",
                  "\r",
                  "        pm.environment.set(\"ACCESS_TOKEN\", accessToken);\r",
                  "        pm.environment.set(\"REFRESH_TOKEN\", refreshToken);\r",
                  "\r",
                  "        console.log(\"Tokens updated successfully.\");\r",
                  "    } else {\r",
                  "        console.warn(\"Login failed according to API: \" + response.message);\r",
                  "    }\r",
                  "} else {\r",
                  "    console.error(\"Request failed with status: \" + pm.response.code);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"email\": \"{{VIZZIO_USER}}\",\r\n    \"password\": \"{{VIZZIO_PASS}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
