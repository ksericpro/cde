    {
      "name": "2. Custom Incident POST (Full Payload)",
      "item": [
        {
          "name": "Create Custom Incident - SOV @ 38ALT (Level 4 War Room)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"site\": \"SOV @ 38ALT\",\n  \"building\": \"HQ Building\",\n  \"floor\": \"Level 4\",\n  \"zone\": \"L4 ICC War Room\",\n  \"deviceName\": \"SOV 38ALT L4 ICC 1 VA CROWDING\",\n  \"incidentType\": \"CROWDING\",\n  \"eventName\": \"Crowd Gathering in L4 ICC War Room\",\n  \"priority\": \"critical\",\n  \"mode\": \"incident\",\n  \"timestamp\": {{$timestamp}},\n  \"metadata\": {\n    \"source\": \"vizzio_va\",\n    \"associatedCamera\": \"SOV 38ALT L4 ICC 1\",\n    \"notes\": \"Triggered from Postman manual test\"\n  }\n}"
            },
            "url": {
              "raw": "{{UPSTREAM_URL}}/api/incidents/monitor",
              "host": [
                "{{UPSTREAM_URL}}"
              ],
              "path": [
                "api",
                "incidents",
                "monitor"
              ]
            },
            "description": "Submits a full custom JSON incident for SOV @ 38ALT directly to the incident monitor API."
          },
          "response": []
        }
      ],
      "description": "Directly posts a comprehensive custom incident payload to /api/incidents/monitor."
    }
