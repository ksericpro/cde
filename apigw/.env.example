# Kong Manager GUI & Admin API URLs
# For local development:
KONG_ADMIN_GUI_URL=http://localhost:8002
KONG_ADMIN_GUI_API_URL=http://localhost:8001

# For remote / production deployment (e.g. 10.65.51.252):
# KONG_ADMIN_GUI_URL=http://10.65.51.252:8002
# KONG_ADMIN_GUI_API_URL=http://10.65.51.252:8001
